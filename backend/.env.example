PORT=5000
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/innsightai
JWT_SECRET=your_jwt_secret_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id
HF_API_KEY=your_huggingface_api_key_here
